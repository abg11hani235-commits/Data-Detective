# Environment Configuration for Data Detective

# Application Environment
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Providers (Configure at least one or rely on built-in heuristic/mock fallback)
# Never expose these keys to the frontend or version control!
GEMINI_API_KEY=
GROQ_API_KEY=

# Preferred primary provider: "gemini" or "groq"
PRIMARY_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Ingestion Constraints
MAX_UPLOAD_SIZE_MB=25
MAX_DATASET_ROWS=250000
MAX_DATASET_COLS=200

# Sandbox Security Controls
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_ALLOW_NETWORK=false

# Storage Directories (Relative to backend or absolute)
DATA_DIR=data
